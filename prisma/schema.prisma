datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

enum ProjectCategory {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  RENOVATION
}

enum ProjectStatus {
  PLANNING
  ONGOING
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DELAYED
}

enum EnquiryStatus {
  NEW
  CONTACTED
  SITE_VISIT_SCHEDULED
  QUOTATION_SENT
  NEGOTIATION
  CONVERTED
  LOST
}

enum EnquirySource {
  WEBSITE_FORM
  COST_ESTIMATOR
  WHATSAPP
  PHONE_CALL
  DIRECT_WALKIN
  REFERRAL
}

enum InteractionType {
  CALL
  EMAIL
  WHATSAPP
  MEETING
  SITE_VISIT
  NOTE
}

enum QualityTier {
  BASIC
  STANDARD
  PREMIUM
  LUXURY
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  name         String
  role         Role          @default(OWNER)
  isActive     Boolean       @default(true)
  sessions     UserSession[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([email])
}

model UserSession {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model Customer {
  id        String    @id @default(uuid())
  name      String
  email     String?
  phone     String
  company   String?
  address   String?
  city      String?
  notes     String?
  enquiries Enquiry[]
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([phone])
  @@index([name])
}

model Enquiry {
  id               String               @id @default(uuid())
  enquiryNumber    String               @unique
  customerName     String
  phone            String
  email            String?
  location         String
  category         ProjectCategory      @default(RESIDENTIAL)
  approxArea       Decimal?             @db.Decimal(12, 2)
  budgetRange      String?
  message          String
  source           EnquirySource        @default(WEBSITE_FORM)
  status           EnquiryStatus        @default(NEW)
  priority         String               @default("NORMAL")
  nextFollowUpDate DateTime?
  notes            String?
  customerId       String?
  customer         Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  interactions     EnquiryInteraction[]
  projects         Project[]
  estimates        CostEstimate[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([status])
  @@index([phone])
  @@index([category])
  @@index([createdAt])
}

model EnquiryInteraction {
  id          String          @id @default(uuid())
  enquiryId   String
  enquiry     Enquiry         @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  type        InteractionType @default(NOTE)
  summary     String
  details     String?
  conductedAt DateTime        @default(now())
  createdBy   String?
  createdAt   DateTime        @default(now())

  @@index([enquiryId])
}

model Project {
  id              String                  @id @default(uuid())
  projectNumber   String                  @unique
  title           String
  slug            String                  @unique
  description     String
  category        ProjectCategory         @default(RESIDENTIAL)
  status          ProjectStatus           @default(PLANNING)
  isFeatured      Boolean                 @default(false)
  isPublic        Boolean                 @default(true)
  location        String
  plotArea        Decimal?                @db.Decimal(12, 2)
  builtUpArea     Decimal?                @db.Decimal(12, 2)
  floors          Int?                    @default(1)
  startDate       DateTime?
  expectedEndDate DateTime?
  actualEndDate   DateTime?
  approvedBudget  Decimal                 @default(0.00) @db.Decimal(14, 2)
  customerId      String?
  customer        Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  enquiryId       String?
  enquiry         Enquiry?                @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  coverImage      String?
  milestones      ProjectMilestone[]
  progressUpdates ProjectProgressUpdate[]
  images          ProjectImage[]
  expenses        Expense[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([status])
  @@index([category])
  @@index([isFeatured])
  @@index([isPublic])
}

model ProjectMilestone {
  id               String                  @id @default(uuid())
  projectId        String
  project          Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  orderIndex       Int                     @default(0)
  weight           Decimal                 @default(10.00) @db.Decimal(5, 2)
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualEndDate    DateTime?
  status           MilestoneStatus         @default(NOT_STARTED)
  progressPercent  Decimal                 @default(0.00) @db.Decimal(5, 2)
  delayReason      String?
  updates          ProjectProgressUpdate[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([projectId])
}

model ProjectProgressUpdate {
  id              String            @id @default(uuid())
  projectId       String
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId     String?
  milestone       ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  title           String
  description     String?
  progressPercent Decimal           @default(0.00) @db.Decimal(5, 2)
  recordedDate    DateTime          @default(now())
  createdBy       String?
  createdAt       DateTime          @default(now())

  @@index([projectId])
}

model ProjectImage {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  isCover   Boolean  @default(false)
  category  String?  @default("GALLERY")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([projectId])
}

model Expense {
  id              String              @id @default(uuid())
  expenseNumber   String              @unique
  projectId       String
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category        String
  description     String
  vendor          String
  amount          Decimal             @db.Decimal(14, 2)
  paymentMethod   String              @default("BANK_TRANSFER")
  referenceNumber String?
  receiptUrl      String?
  expenseDate     DateTime            @default(now())
  notes           String?
  createdBy       String?
  attachments     ExpenseAttachment[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([projectId])
  @@index([category])
  @@index([expenseDate])
}

model ExpenseAttachment {
  id        String   @id @default(uuid())
  expenseId String
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  fileUrl   String
  fileName  String
  fileSize  Int?
  mimeType  String?
  createdAt DateTime @default(now())

  @@index([expenseId])
}

model CostRateProfile {
  id                    String         @id @default(uuid())
  name                  String
  projectType           String         @default("RESIDENTIAL")
  baseCivilRate         Decimal        @db.Decimal(10, 2)
  finishingRate         Decimal        @db.Decimal(10, 2)
  electricalRate        Decimal        @db.Decimal(10, 2)
  plumbingRate          Decimal        @db.Decimal(10, 2)
  waterproofingRate     Decimal        @db.Decimal(10, 2)
  basicMultiplier       Decimal        @default(0.85) @db.Decimal(5, 2)
  standardMultiplier    Decimal        @default(1.00) @db.Decimal(5, 2)
  premiumMultiplier     Decimal        @default(1.30) @db.Decimal(5, 2)
  luxuryMultiplier      Decimal        @default(1.70) @db.Decimal(5, 2)
  defaultContingencyPct Decimal        @default(5.00) @db.Decimal(5, 2)
  defaultTaxPct         Decimal        @default(0.00) @db.Decimal(5, 2)
  isActive              Boolean        @default(true)
  version               Int            @default(1)
  estimates             CostEstimate[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([projectType, isActive])
}

model CostEstimate {
  id                 String                 @id @default(uuid())
  estimateNumber     String                 @unique
  projectType        String                 @default("RESIDENTIAL")
  location           String
  plotArea           Decimal?               @db.Decimal(12, 2)
  builtUpArea        Decimal                @db.Decimal(12, 2)
  floors             Int                    @default(1)
  qualityTier        QualityTier            @default(STANDARD)
  civilCost          Decimal                @db.Decimal(14, 2)
  finishingCost      Decimal                @db.Decimal(14, 2)
  electricalCost     Decimal                @db.Decimal(14, 2)
  plumbingCost       Decimal                @db.Decimal(14, 2)
  waterproofingCost  Decimal                @db.Decimal(14, 2)
  additionalCost     Decimal                @default(0.00) @db.Decimal(14, 2)
  contingencyCost    Decimal                @default(0.00) @db.Decimal(14, 2)
  taxCost            Decimal                @default(0.00) @db.Decimal(14, 2)
  totalEstimatedCost Decimal                @db.Decimal(14, 2)
  costPerSqFt        Decimal                @db.Decimal(10, 2)
  durationMonths     Int?                   @default(12)
  customerName       String?
  customerPhone      String?
  customerEmail      String?
  enquiryId          String?
  enquiry            Enquiry?               @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  rateProfileId      String?
  rateProfile        CostRateProfile?       @relation(fields: [rateProfileId], references: [id], onDelete: SetNull)
  rateSnapshotJson   String?
  lineItems          CostEstimateLineItem[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([estimateNumber])
  @@index([createdAt])
}

model CostEstimateLineItem {
  id          String       @id @default(uuid())
  estimateId  String
  estimate    CostEstimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  category    String
  description String
  rate        Decimal      @db.Decimal(10, 2)
  quantity    Decimal      @db.Decimal(12, 2)
  unit        String
  amount      Decimal      @db.Decimal(14, 2)
  createdAt   DateTime     @default(now())

  @@index([estimateId])
}

model CompanySettings {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}

model ActivityLog {
  id          String   @id @default(uuid())
  action      String
  entityType  String
  entityId    String?
  details     String?
  performedBy String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
